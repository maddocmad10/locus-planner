<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Planner data may be backed up, but sync pairing
     state must not follow it to another phone: the bearer token lives in
     Keystore-backed storage that cannot be restored, and cursors that point
     into a different desktop history would be wrong. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="locus_reminders.xml" />

        <!-- Database bytes without the device-local key are unusable and would
             turn a cloud restore into a recovery dead end. The logical v3
             backup exported by the user is the supported restore path. -->
        <exclude domain="file" path="locus_planner.db" />
        <exclude domain="file" path="locus_planner.db-wal" />
        <exclude domain="file" path="locus_planner.db-shm" />
        <exclude domain="file" path="locus_planner.db-journal" />
        <exclude domain="file" path="locus_planner.db.meta.json" />
        <exclude domain="file" path="locus_planner.db.migration.json" />
        <exclude domain="file" path="quarantine/" />
        <exclude domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="locus_reminders.xml" />

        <!-- Same rule for direct device-to-device transfer: the DEK does not
             travel with the database. -->
        <exclude domain="file" path="locus_planner.db" />
        <exclude domain="file" path="locus_planner.db-wal" />
        <exclude domain="file" path="locus_planner.db-shm" />
        <exclude domain="file" path="locus_planner.db-journal" />
        <exclude domain="file" path="locus_planner.db.meta.json" />
        <exclude domain="file" path="locus_planner.db.migration.json" />
        <exclude domain="file" path="quarantine/" />
        <exclude domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
