<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older backup rules; see data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <!-- Pending reminder alarms belong to this install; alarms are not restored. -->
    <exclude domain="sharedpref" path="locus_reminders.xml" />
</full-backup-content>
