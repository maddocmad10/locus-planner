  "fixed_sql": [
    {
      "name": "events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"events\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"start_time\" INTEGER NOT NULL, \"end_time\" INTEGER NULL, \"category\" TEXT NOT NULL DEFAULT 'general', \"has_reminder\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_reminder\" IN (0, 1)), \"reminder_minutes\" INTEGER NOT NULL DEFAULT 10, \"recurrence_rule\" TEXT NULL, \"all_day\" INTEGER NOT NULL DEFAULT 0 CHECK (\"all_day\" IN (0, 1)), \"recurrence_end\" INTEGER NULL, \"recurrence_exceptions\" TEXT NOT NULL DEFAULT '[]', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"target_date\" INTEGER NULL, \"target_progress\" INTEGER NOT NULL DEFAULT 100, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "progress_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"progress_logs\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT REFERENCES projects(id) ON DELETE CASCADE, \"value\" INTEGER NOT NULL, \"note\" TEXT NULL, \"timestamp\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT REFERENCES projects(id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completed\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "diary_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"diary_entries\" (\"id\" TEXT NOT NULL, \"date\" INTEGER NOT NULL UNIQUE, \"mood\" INTEGER NOT NULL, \"content\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"icon\" TEXT NOT NULL DEFAULT '🔥', \"created_at\" INTEGER NOT NULL, \"target_per_week\" INTEGER NOT NULL DEFAULT 5, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habit_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_logs\" (\"id\" TEXT NOT NULL, \"habit_id\" TEXT REFERENCES habits(id) ON DELETE CASCADE, \"date\" INTEGER NOT NULL, \"completed\" INTEGER NOT NULL DEFAULT 1 CHECK (\"completed\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "focus_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"focus_sessions\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NULL REFERENCES projects(id) ON DELETE SET NULL, \"start_time\" INTEGER NOT NULL, \"duration_minutes\" INTEGER NOT NULL, \"note\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "todo_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"todo_items\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"notes\" TEXT NULL, \"completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completed\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"start_date\" INTEGER NULL, \"due_date\" INTEGER NULL, \"priority\" INTEGER NOT NULL DEFAULT 0, \"tags\" TEXT NOT NULL DEFAULT '[]', \"recurrence_rule\" TEXT NULL, \"parent_id\" TEXT NULL REFERENCES todo_items(id) ON DELETE CASCADE, \"project_id\" TEXT NULL REFERENCES projects(id) ON DELETE SET NULL, \"reminder_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "todo_completions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"todo_completions\" (\"id\" TEXT NOT NULL, \"todo_id\" TEXT NOT NULL REFERENCES todo_items(id) ON DELETE CASCADE, \"occurrence_due\" INTEGER NULL, \"completed_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "daily_plans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_plans\" (\"id\" TEXT NOT NULL, \"day_key\" TEXT NOT NULL UNIQUE, \"intention\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "daily_plan_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_plan_items\" (\"id\" TEXT NOT NULL, \"plan_id\" TEXT NOT NULL REFERENCES daily_plans(id) ON DELETE CASCADE, \"todo_item_id\" TEXT NULL REFERENCES todo_items(id) ON DELETE CASCADE, \"project_task_id\" TEXT NULL REFERENCES tasks(id) ON DELETE CASCADE, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"planned_minutes\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"),     CHECK (\n      (todo_item_id IS NOT NULL AND project_task_id IS NULL)\n      OR\n      (todo_item_id IS NULL AND project_task_id IS NOT NULL)\n    )\n    , CHECK (planned_minutes IS NULL OR planned_minutes > 0));"
        }
      ]
    },
    {
      "name": "sync_outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_outbox\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"entity_type\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"operation\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"device_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    }
